c4 -> rechazo [label="No"];
c4 -> i4 [label="Sí"];
i4 [label="0 ≤ contraste entre extremos < 0.13"];
f4 [shape=box,label="Interior = no"];
i4 -> f4 [label="No (frontera)"];
i4 -> s4 [label="Sí"];
f4 -> s4;
s4 [shape=point];
c5 [label="0.88 ≤ fracción ancha ≤ 1"];
